# The estate reads these from your shell (PowerShell: $env:NAME = "value"). Every one has a default:
# you need none of them to follow the course. Never put a real provider key here.

# Where the practice state lives (registry, keys, usage records, logs, the practice database)
ESTATE_STATE=state
# Who you are in the audit trail when you run estate commands
ESTATE_ACTOR=usr-kwame

# Ports of the services
SIM_PORT=8320
ESTATE_PORT=8321
GATEWAY_PORT=8322

# The provider simulator: recorded latency x SIM_SPEED (0 = answer at once, 1 = as recorded),
# its simulated egress rule (open | gateway-only), and the replayed clock for scenarios (off | on)
SIM_SPEED=0
SIM_EGRESS=open
SIM_REPLAY_CLOCK=off

# The gateway: its upstream timeout, optional OpenTelemetry spans (off | on; needs requirements-otel.txt),
# and whether suspensions are pushed to the replicas at once (on | off)
GATEWAY_UPSTREAM_TIMEOUT=60
GATEWAY_OTEL=off
ESTATE_PUSH=on

# The agents course's workflow on the platform
# RESOLVER_PROVIDER=gateway
# RESOLVER_MODEL=strong-reasoning
# ESTATE_GATEWAY_URL=http://127.0.0.1:8322/v1
# ESTATE_URL=http://127.0.0.1:8321
