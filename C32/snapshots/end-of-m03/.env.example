# The estate reads these from your shell (PowerShell: $env:NAME = "value"). Every one has a default:
# you need none of them to follow the course. Never put a real provider key here.

# Where the practice state lives (registry, keys, logs, the practice database)
ESTATE_STATE=state
# Who you are in the audit trail when you run estate commands
ESTATE_ACTOR=usr-kwame

# Ports of the services
SIM_PORT=8320
ESTATE_PORT=8321
GATEWAY_PORT=8322

# The provider simulator: recorded latency x SIM_SPEED (0 = answer at once, 1 = as recorded),
# its simulated egress rule (open | gateway-only), and the replayed clock for scenarios (off | on)
SIM_SPEED=0
SIM_EGRESS=open
SIM_REPLAY_CLOCK=off
