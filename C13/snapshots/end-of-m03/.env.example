# doc-extract settings. Copy this file to .env only if you change something; every value has a default.
# The files to read (the course's documents are made by: python -m doc_extract.generate)
DOCS_DIR=data
# Files larger than this are stopped at intake (megabytes)
MAX_FILE_MB=8

# Optional: a live call to a vision model with YOUR key (python -m doc_extract.vision D036 --live).
# Without these, the project replays the course's recorded answers and sends nothing anywhere.
# Any OpenAI-compatible endpoint that reads images, for example https://api.openai.com/v1
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
