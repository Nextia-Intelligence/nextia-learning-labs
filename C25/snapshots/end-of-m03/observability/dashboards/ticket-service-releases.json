{
  "uid": "ticket-service-releases",
  "title": "Ticket service: release comparison",
  "description": "Releases side by side over the chosen time range: the canary against the active release.",
  "tags": [
    "ticket-service"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 41,
  "templating": {
    "list": [
      {
        "name": "release",
        "label": "Release",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(app_tickets_triaged_total{release_id!=\"none\"}, release_id)",
          "refId": "R"
        },
        "definition": "label_values(app_tickets_triaged_total{release_id!=\"none\"}, release_id)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Releases over the time range",
      "description": "Finished tickets, the share with no answer, the share sent to a person, cost per 1,000 tickets and time to a draft (p95), per release.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (release_id) (increase(app_tickets_triaged_total{release_id=~\"$release\",release_id!=\"none\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (release_id) (increase(app_tickets_triaged_total{release_id=~\"$release\",release_id!=\"none\",outcome=\"no_answer\"}[$__range])) / sum by (release_id) (increase(app_tickets_triaged_total{release_id=~\"$release\",release_id!=\"none\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (release_id) (increase(app_tickets_triaged_total{release_id=~\"$release\",release_id!=\"none\",needs_human=\"true\"}[$__range])) / sum by (release_id) (increase(app_tickets_triaged_total{release_id=~\"$release\",release_id!=\"none\",outcome=\"ok\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1000 * sum by (release_id) (increase(app_ai_cost_USD_total{release_id=~\"$release\",release_id!=\"none\"}[$__range])) / sum by (release_id) (increase(app_tickets_triaged_total{release_id=~\"$release\",release_id!=\"none\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, release_id) (increase(app_ticket_time_to_draft_seconds_bucket{release_id=~\"$release\",release_id!=\"none\"}[$__range])))",
          "legendFormat": "__auto",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "release_id": "release",
              "Value #A": "tickets",
              "Value #B": "no answer",
              "Value #C": "sent to a person",
              "Value #D": "US$ per 1,000",
              "Value #E": "time to a draft p95 (s)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "no answer"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sent to a person"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tickets"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      }
    },
