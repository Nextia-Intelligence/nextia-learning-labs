{
  "uid": "ticket-service-traces",
  "title": "Ticket service: traces and events",
  "description": "Find a ticket's trace: slow, failed or expensive steps, and the events that link to them.",
  "tags": [
    "ticket-service"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 41,
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "table",
      "title": "Ticket jobs that failed",
      "description": "One row per trace: open it to see the waterfall of the API request and the job.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{name=\"process ticket job\" && status=error}",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Slow triage calls (over 5 s)",
      "description": "The provider call of the triage step, slower than 5 seconds.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{name=\"chat chat-small\" && duration > 5s}",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Ticket jobs (latest)",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{name=\"process ticket job\"}",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 9
      }
    },
    {
      "type": "logs",
      "title": "Tickets that did not get a valid draft (ticket.triaged events)",
      "description": "Log events with their trace ID: open a line to go to its trace.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=\"ticket-worker\"} |= \"ticket.triaged\" | outcome != \"ok\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 10
      }
    }
  ]
}
