# Copy this file to .env and change the password in all three places.
# Never commit .env.
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://tickets:change-me-local-only@127.0.0.1:5432/tickets
# The tests use their own database and delete everything in it.
TEST_DATABASE_URL=postgresql://tickets:change-me-local-only@127.0.0.1:5432/tickets_test
# Object storage (Module 5): Azurite, Microsoft's Azure Blob Storage emulator.
# The account name and key are Azurite's public test key, the same for everyone.
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# The AI provider (the scaling course): the simulated one, python -m simulator.
# For a real OpenAI-compatible provider, set its URL and PROVIDER_API_KEY (never commit it).
PROVIDER_URL=http://127.0.0.1:8300/v1
# The shared cache (Module 3 of the scaling course): Valkey, docker compose up -d cache.
CACHE_URL=redis://127.0.0.1:6379/0
# The tests use their own cache database (15) and delete everything in it.
TEST_CACHE_URL=redis://127.0.0.1:6379/15
# The help desk's assistant (the MLOps course): the prompt of the triage step,
# a file in ticket_api/prompts/ (assistant-v2 is the live prompt).
ASSISTANT_PROMPT=assistant-v2
# The release manifest (Module 2): operations/releases/<RELEASE_ID>.toml. When it is set, the
# manifest names the prompt, and its ID goes on every AI result. Empty = no release.
RELEASE_ID=
# Telemetry (Module 3): traces, metrics and logs with OpenTelemetry. Saved to files that
# python -m ops reads ({service} = ticket-api or ticket-worker), and, if the Grafana stack runs
# (docker compose --profile observability up -d observability), sent to its collector.
TELEMETRY_FILE=telemetry/{service}.jsonl
OTEL_EXPORTER_OTLP_ENDPOINT=
# The share of tickets that get a trace (1.0 = all). Logs and metrics count every ticket.
TELEMETRY_SAMPLE=1.0
# Never put ticket text, replies or questions in telemetry (true only to see the risk).
TELEMETRY_CAPTURE_CONTENT=false
# Remove text and mask e-mail addresses and card numbers before export.
TELEMETRY_REDACT=true
TELEMETRY_RETENTION_DAYS=30
