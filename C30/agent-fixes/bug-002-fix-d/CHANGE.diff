+"""Regression coverage for policy validity and the return window."""
+
+import pytest
+
+from helpdesk import assistant, corpus, store, tools
+
+
+@pytest.mark.parametrize(
+    "day,version",
+    [("2026-10-30", 3), ("2026-10-31", 3), ("2026-11-01", 4), ("2026-11-16", 4)],
+)
+def test_return_policy_validity_boundaries(day, version):
+    for section in corpus.find("returns-policy"):
+        assert corpus.in_force(section, day) == (section.version == version)
+    found = corpus.search("How many days do I have to return an unused item?", today=day)
+    returns = [s for s, _ in found if s.doc_id == "returns-policy"]
+    assert returns
+    assert {s.version for s in returns} == {version}
+
+
+def test_policy_not_in_force_before_start():
+    section = corpus.find("returns-policy", 3)[0]
+    assert not corpus.in_force(section, "2025-02-28")
+
+
+@pytest.mark.parametrize("seed", range(1, 51))
+def test_current_return_answer_never_uses_expired_policy(tmp_path, monkeypatch, seed):
+    monkeypatch.setenv("HELPDESK_HOME", str(tmp_path / "home"))
+    store.reset()
+    cid = assistant.start(seed=seed)
+    out = assistant.send(cid, "How many days do I have to return an unused item?")
+    assert "45 days" in out["reply"]
+    assert "30 days" not in out["reply"]
+    trace = store.get_trace(out["trace_id"])
+    assert "returns-policy@4#return-window" in trace["cited"]
+    assert all(s["doc_id"] != "returns-policy" or s["version"] == 4 for s in trace["retrieved"])
+
+
+@pytest.mark.parametrize("delivered,window", [("2026-10-31", 30), ("2026-11-01", 45)])
+def test_order_return_window_uses_delivery_date(delivered, window):
+    assert tools.return_window(delivered) == window
