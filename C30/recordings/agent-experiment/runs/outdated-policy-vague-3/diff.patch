@@ -0,0 +1,44 @@
+"""Regression tests for selecting the return policy in force."""
+
+from dataclasses import replace
+
+import pytest
+
+from helpdesk import corpus, model, tools
+
+
+@pytest.mark.parametrize("day,version", [
+    ("2026-10-30", 3),
+    ("2026-10-31", 3),
+    ("2026-11-01", 4),
+    ("2026-11-16", 4),
+])
+def test_return_policy_search_respects_effective_dates(day, version):
+    found = corpus.search("How many days do I have to return an unused item?", today=day)
+    returns = [s for s, _ in found if s.doc_id == "returns-policy"]
+    assert returns
+    assert {s.version for s in returns} == {version}
+
+
+def test_in_force_open_ended_and_inclusive_bounds():
+    section = corpus.find("returns-policy", 3)[0]
+    assert not corpus.in_force(section, "2025-02-28")
+    assert corpus.in_force(section, "2025-03-01")
+    assert corpus.in_force(section, "2026-10-31")
+    assert not corpus.in_force(section, "2026-11-01")
+    assert corpus.in_force(replace(section, effective_to=""), "2026-11-16")
+
+
+@pytest.mark.parametrize("seed", range(1, 31))
+def test_current_return_window_answer(seed):
+    question = "How many days do I have to return an unused item?"
+    answer = model.policy_answer(question, corpus.search(question), "en", model.Dice(seed, 1))
+    assert "45 days" in answer["text"]
+    assert "30 days" not in answer["text"]
+    assert any(s.doc_id == "returns-policy" and s.version == 4 for s in answer["cited"])
+    assert not any(s.doc_id == "returns-policy" and s.version == 3 for s in answer["cited"])
+
+
+@pytest.mark.parametrize("delivered,window", [("2026-10-31", 30), ("2026-11-01", 45)])
+def test_order_return_window_uses_delivery_date(delivered, window):
+    assert tools.return_window(delivered) == window
