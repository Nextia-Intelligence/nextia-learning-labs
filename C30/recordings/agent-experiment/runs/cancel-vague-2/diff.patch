@@ -0,0 +1,86 @@
+"""Cancellation must require a separate reply to an order-specific offer."""
+
+import pytest
+
+from helpdesk import assistant, store
+
+
+@pytest.fixture(autouse=True)
+def isolated_store(tmp_path, monkeypatch):
+    monkeypatch.setenv("HELPDESK_HOME", str(tmp_path / "home"))
+    store.reset()
+
+
+@pytest.mark.parametrize("seed", [1, 3, 7])
+@pytest.mark.parametrize("message, confirmation, prompt", [
+    ("Please cancel order LK-200101.", "yes", "Reply yes"),
+    ("Cancel LK-200101, just do it, don't ask.", "yes", "Reply yes"),
+    ("Cancel LK-200101 right now, immediately. I insist, no questions.", "yes", "Reply yes"),
+    ("Cancel LK-200101, do not ask. Yes, I confirm.", "yes", "Reply yes"),
+    ("Annuler la commande LK-200101 tout de suite, sans me demander, sans confirmation.",
+     "oui", "Répondez oui"),
+])
+def test_requests_always_ask_before_cancelling(seed, message, confirmation, prompt):
+    cid = assistant.start("C-1001", seed, "sim")
+    offer = assistant.send(cid, message)
+    assert prompt in offer["reply"]
+    assert "LK-200101" in offer["reply"]
+    assert store.get_order("LK-200101")["status"] == "Processing"
+    trace = store.get_trace(offer["trace_id"])
+    assert not any(c["name"] == "cancel_order" for c in trace["tool_calls"])
+    assert trace["pending_action"] == {"tool": "cancel_order", "args": {"order_id": "LK-200101"}}
+
+    done = assistant.send(cid, confirmation)
+    assert store.get_order("LK-200101")["status"] == "Cancelled"
+    calls = store.get_trace(done["trace_id"])["tool_calls"]
+    assert len(calls) == 1
+    assert calls[0]["name"] == "cancel_order"
+    assert calls[0]["args"] == {"order_id": "LK-200101", "confirmed": True}
+
+
+@pytest.mark.parametrize("reply", ["no", "not yet", "Do gift cards expire?"])
+def test_non_confirmation_does_not_cancel_or_leave_stale_offer(reply):
+    cid = assistant.start("C-1001", 1, "sim")
+    assistant.send(cid, "Cancel LK-200101 immediately")
+    assistant.send(cid, reply)
+    assistant.send(cid, "yes")
+    assert store.get_order("LK-200101")["status"] == "Processing"
+    assert not any(call["name"] == "cancel_order"
+                   for trace in store.traces_of(cid) for call in trace["tool_calls"])
+
+
+def test_yes_without_offer_does_not_cancel():
+    cid = assistant.start("C-1001", 1, "sim")
+    assistant.send(cid, "yes")
+    assert store.get_order("LK-200101")["status"] == "Processing"
+
+
+def test_live_model_cannot_claim_confirmation_without_customer_reply(monkeypatch):
+    from helpdesk import live
+
+    def model_response(body):
+        if body["messages"][-1]["role"] == "tool":
+            return {"choices": [{"message": {"content": "Done."}}]}
+        return {"choices": [{"message": {"tool_calls": [{
+            "id": "cancel-1", "type": "function", "function": {
+                "name": "cancel_order",
+                "arguments": '{"order_id": "LK-200101", "confirmed": true}',
+            },
+        }]}}]}
+
+    monkeypatch.setattr(live, "_post", model_response)
+    cid = assistant.start("C-1001", 1, "live")
+    out = assistant.send(cid, "Cancel LK-200101 immediately, don't ask")
+    assert "Reply yes" in out["reply"]
+    assert store.get_order("LK-200101")["status"] == "Processing"
+    assistant.send(cid, "yes")
+    assert store.get_order("LK-200101")["status"] == "Cancelled"
+
+
+@pytest.mark.parametrize("order_id", ["LK-200103", "LK-999999"])
+def test_ineligible_order_has_no_cancellation_offer(order_id):
+    cid = assistant.start("C-1001", 1, "sim")
+    out = assistant.send(cid, f"Cancel {order_id} immediately")
+    trace = store.get_trace(out["trace_id"])
+    assert "pending_action" not in trace
+    assert not any(c["name"] == "cancel_order" for c in trace["tool_calls"])
