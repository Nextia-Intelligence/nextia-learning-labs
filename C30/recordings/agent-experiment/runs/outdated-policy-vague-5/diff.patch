+"""Regression tests for return policy effective dates and answers."""
+
+import pytest
+
+from helpdesk import assistant, corpus, store, tools
+
+
+@pytest.mark.parametrize("today, version", [
+    ("2026-10-31", 3),
+    ("2026-11-01", 4),
+    ("2026-11-16", 4),
+])
+def test_return_policy_date_boundaries(today, version):
+    windows = [s for s in corpus.find("returns-policy") if s.heading == "Return window"]
+    assert [s.version for s in windows if corpus.in_force(s, today)] == [version]
+    found = corpus.search("How many days do I have to return an unused item?", today=today)
+    assert found
+    assert all(s.version == version for s, _ in found if s.doc_id == "returns-policy")
+
+
+def test_current_return_window_across_seeds(tmp_path, monkeypatch):
+    monkeypatch.setenv("HELPDESK_HOME", str(tmp_path / "home"))
+    store.reset()
+    for seed in range(1, 51):
+        cid = assistant.start(seed=seed)
+        out = assistant.send(cid, "How many days do I have to return an unused item?")
+        assert "45 days" in out["reply"], (seed, out["reply"])
+        assert "30 days" not in out["reply"], (seed, out["reply"])
+        trace = store.get_trace(out["trace_id"])
+        assert "returns-policy@4#return-window" in trace["cited"]
+        assert all(r["version"] == 4 for r in trace["retrieved"] if r["doc_id"] == "returns-policy")
+
+
+@pytest.mark.parametrize("delivered, days", [("2026-10-31", 30), ("2026-11-01", 45)])
+def test_order_window_uses_delivery_date(delivered, days):
+    assert tools.return_window(delivered) == days
