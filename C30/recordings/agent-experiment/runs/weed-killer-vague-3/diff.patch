+# Words that start a refusal. Keep scanning after removing a garden-product
+# phrase: mentioning weed killer must not exempt the rest of a request.
+BLOCKED_WORDS = ["kill", "poison", "weapon", "bomb", "explosive", "hurt", "suicide", "harm"]
+
+GARDEN_PHRASES = re.compile(
+    r"\b(?:weed[\s-]*killers?|kill(?:s|ing|ed)?\s+(?:the\s+)?weeds?)\b"
+)
+
+# A product name alone is safe, but requests to apply it to people or animals
+# are not. Safety questions (e.g. 'is weed killer safe around pets?') do not
+# match this action pattern.
+HARMFUL_APPLICATION = re.compile(
+    r"\b(?:use|apply|put|pour|spray|give|feed)\b[^.!?;]*"
+    r"\bweed[\s-]*killers?\b[^.!?;]*\b(?:on|to|into)\s+"
+    r"(?:(?:a|an|the|my|your|his|her|their|our)\s+)*"
+    r"(?:people|person|someone|humans?|neighbou?rs?|pets?|animals?|dogs?|cats?|"
+    r"children|child|baby|babies|wife|husband)\b"
+)
 
 
 def blocked(message: str) -> str | None:
-    """The blocked word found in the message, or None."""
+    """The blocked word found in the message, or None.
+
+    Exempt only recognized gardening phrases, never the whole message. This
+    remains a conservative keyword filter, not a general intent classifier.
+    """
     text = fold(message)
+    if HARMFUL_APPLICATION.search(text):
+        return "kill"
+    text = GARDEN_PHRASES.sub("", text)
     for word in BLOCKED_WORDS:
