--- a/helpdesk/safety.py
+++ b/helpdesk/safety.py
@@ -1,14 +1,35 @@
 """The safety filter: messages that the assistant refuses before the model sees them."""
+
+import re
 
 from .corpus import fold
 
 # Words that start a refusal.
 BLOCKED_WORDS = ["kill", "poison", "weapon", "bomb", "explosive", "hurt", "suicide"]
 
+# A product name is not an intent to harm. Remove only this phrase from the
+# keyword scan, never exempt the whole message (which may still ask for harm).
+WEED_KILLER = re.compile(r"\bweed[\s-]*killers?\b")
+KILL_WEEDS = re.compile(r"\bkill(?:s|ing)?\s+(?:(?:the|these|my)\s+)?weeds\b")
+
+# Catch chemical misuse even when it doesn't explicitly say "kill" or "hurt".
+# Ordinary questions about safety around pets/people do not match these forms.
+CHEMICAL_MISUSE = re.compile(
+    r"\b(?:put|add|mix|pour)\b[^.!?]*\b(?:food|drink|water supply)\b"
+    r"|\b(?:spray|apply|use|give|pour)\b[^.!?]*\b(?:on|onto|to)\s+"
+    r"(?:(?:my|a|the|someone's|your|their)\s+)*"
+    r"(?:person|people|someone|neighbor|neighbour|child|children|dog|cat|pet|animal)s?\b"
+)
+
 
 def blocked(message: str) -> str | None:
     """The blocked word found in the message, or None."""
     text = fold(message)
+    if WEED_KILLER.search(text):
+        if CHEMICAL_MISUSE.search(text):
+            return "kill"
+        text = WEED_KILLER.sub("garden product", text)
+    text = KILL_WEEDS.sub("remove weeds", text)
     for word in BLOCKED_WORDS:
         if word in text:
             return word
