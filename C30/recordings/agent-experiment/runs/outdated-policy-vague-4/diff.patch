+"""Regression coverage for return-policy effective dates and answers."""
+
+import pytest
+
+from helpdesk import assistant, corpus, store, tools
+
+
+@pytest.mark.parametrize(
+    "today, expected_version",
+    [
+        ("2025-02-28", None),
+        ("2025-03-01", 3),
+        ("2026-10-30", 3),
+        ("2026-10-31", 3),
+        ("2026-11-01", 4),
+        ("2026-11-16", 4),
+    ],
+)
+def test_return_policy_effective_dates(today, expected_version):
+    active = {
+        s.version for s in corpus.find("returns-policy") if corpus.in_force(s, today)
+    }
+    assert active == (set() if expected_version is None else {expected_version})
+    found = corpus.search("How many days do I have to return an unused item?", today=today)
+    versions = {s.version for s, _ in found if s.doc_id == "returns-policy"}
+    assert versions == active
+
+
+@pytest.mark.parametrize("seed", range(1, 21))
+def test_current_return_window_answer(tmp_path, monkeypatch, seed):
+    monkeypatch.setenv("HELPDESK_HOME", str(tmp_path / "home"))
+    store.reset()
+    cid = assistant.start(seed=seed)
+    out = assistant.send(cid, "How many days do I have to return an unused item?")
+    assert "45 days" in out["reply"]
+    assert "30 days" not in out["reply"]
+    trace = store.get_trace(out["trace_id"])
+    assert any(key.startswith("returns-policy@4#") for key in trace["cited"])
+    assert not any(key.startswith("returns-policy@3#") for key in trace["cited"])
+    assert not any(
+        ref["doc_id"] == "returns-policy" and ref["version"] == 3
+        for ref in trace["retrieved"]
+    )
+
+
+@pytest.mark.parametrize("delivered, window", [("2026-10-31", 30), ("2026-11-01", 45)])
+def test_order_window_still_uses_delivery_date(delivered, window):
+    assert tools.return_window(delivered) == window
