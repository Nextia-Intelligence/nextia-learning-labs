# Copy this file to .env and fill it in. Never commit .env: it can hold a key.
# The default needs nothing: the mock provider replays the course's recorded model decisions.
RESOLVER_PROVIDER=mock
RESOLVER_MODEL=chat-small

# Option 1, free and local: Ollama (https://ollama.com), then `ollama pull gemma3:4b`.
# gemma3:4b in Ollama has no tool calling: use --variant agent_structured, router or fixed.
# RESOLVER_PROVIDER=openai_compatible
# RESOLVER_BASE_URL=http://localhost:11434/v1
# RESOLVER_MODEL=gemma3:4b

# Option 2, your own key with a hosted provider that offers the OpenAI-compatible API (paid per token)
# RESOLVER_PROVIDER=openai_compatible
# RESOLVER_BASE_URL=https://api.openai.com/v1
# RESOLVER_MODEL=<a model name from your provider>
# RESOLVER_API_KEY=<your key>
# Some reasoning models need this for tool calling; others reject it. Leave it empty unless you need it.
# RESOLVER_REASONING_EFFORT=none

# The usage cap per task (live runs): model calls, seconds waiting for the model, US dollars
# RESOLVER_MAX_STEPS=8
# RESOLVER_MAX_SECONDS=120
# RESOLVER_MAX_COST_USD=0.05
# RESOLVER_TIMEOUT_S=60

# ---- Telemetry (the observability course)
# Where the workflow sends its telemetry: file (default: work/telemetry and the audit store work/audit),
# otlp (a Collector at OTEL_EXPORTER_OTLP_ENDPOINT), file,otlp (both), or off.
# OBS_EXPORT=file
# OBS_TELEMETRY=work/telemetry
# OBS_AUDIT=work/audit/audit.jsonl
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# The release name on every span and metric
# OBS_RELEASE=2.0.0
# Text on telemetry: off. Turn it on ONLY for the redaction exercise; the Collector must remove it.
# OBS_CAPTURE_CONTENT=off
# The handoff message between the two workers carries the trace context (on) or not (off)
# OBS_HANDOFF_CONTEXT=on
# Times in obs's output: hours from UTC (Larkfield: Toronto, -4 in October)
# OBS_TZ_OFFSET=-4

# ---- Release settings (the replayed week uses them; the defaults are the healthy release)
# RESOLVER_RETRY=safe            naive: a timed-out write is sent again with a new ID
# RESOLVER_REPLY_FAILURE=person  close: a failed reply still closes the ticket as resolved
# RESOLVER_HARD_MODEL=           chat-strong: hard tickets go to the structured agent on chat-strong

# ---- Optional
# RESOLVER_TOOLS=mcp             the order lookup through an MCP server (requirements-mcp.txt)
# RESOLVER_PROVIDER=gateway      model calls through the governance course's gateway (gateway-lab.md)
# OBS_GATEWAY_CONTEXT=on         send the real trace context to the gateway
