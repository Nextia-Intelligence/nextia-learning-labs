   }
  },
  {
   "type": "timeseries",
   "title": "Runs stopped by a limit",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (larkfield_stop_reason) (increase(larkfield_run_stops_total[90s]))",
     "legendFormat": "{{larkfield_stop_reason}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 13,
   "gridPos": {
    "x": 8,
    "y": 21,
    "w": 8,
