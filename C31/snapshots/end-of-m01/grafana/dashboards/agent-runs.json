{
 "uid": "agent-runs",
 "title": "Support workflow: runs, cost and writes",
 "description": "The live support workflow's metrics. Windows of 90 s = one practice day in the compressed week.",
 "tags": [
  "support-workflow"
 ],
 "timezone": "browser",
 "editable": false,
 "graphTooltip": 1,
 "refresh": "10s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "schemaVersion": 41,
 "panels": [
  {
   "type": "stat",
   "title": "Runs closed (window)",
   "description": "Runs that ended in the last practice day",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(larkfield_runs_total[90s]))",
     "legendFormat": "__auto",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 5
   }
  },
  {
   "type": "stat",
   "title": "Resolved share",
   "description": "Resolved tickets / all closed tickets (not the same as right: see the reviews)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(larkfield_runs_total{larkfield_outcome=\"resolved\"}[90s])) / sum(increase(larkfield_runs_total[90s]))",
     "legendFormat": "__auto",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "id": 2,
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 5
   }
  },
  {
   "type": "stat",
   "title": "Handed to a person",
   "description": "Alert above 45%",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(larkfield_runs_total{larkfield_outcome=\"handed_to_person\"}[90s])) / sum(increase(larkfield_runs_total[90s]))",
     "legendFormat": "__auto",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "id": 3,
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 5
   }
  },
  {
   "type": "stat",
   "title": "US$ per resolved ticket",
   "description": "Model cost / resolved tickets. Budget US$0.002 (assumption)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(larkfield_run_cost_total[90s])) / sum(increase(larkfield_runs_total{larkfield_outcome=\"resolved\"}[90s]))",
     "legendFormat": "__auto",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "decimals": 4,
   "id": 4,
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 5
   }
  },
  {
   "type": "stat",
   "title": "Unreconciled write timeouts",
   "description": "A write that timed out and that nobody checked: it may have happened twice",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(larkfield_writes_total{larkfield_write_outcome=\"timeout\"}[90s])) - sum(increase(larkfield_reconciles_total[90s]))",
     "legendFormat": "__auto",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "id": 5,
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 5
   }
  },
  {
   "type": "stat",
   "title": "Reply failures",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(larkfield_tool_calls_total{gen_ai_tool_name=\"send_reply\",larkfield_tool_status=\"failed\"}[90s]))",
     "legendFormat": "__auto",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "id": 6,
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 5
   }
  },
  {
   "type": "timeseries",
   "title": "Runs by outcome",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (larkfield_outcome) (increase(larkfield_runs_total[90s]))",
     "legendFormat": "{{larkfield_outcome}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 7,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Cost per resolved ticket, by model",
   "description": "Before and after the switch to chat-strong for hard tickets",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (gen_ai_request_model) (increase(larkfield_run_cost_total[90s])) / sum by (gen_ai_request_model) (increase(larkfield_runs_total{larkfield_outcome=\"resolved\"}[90s]))",
     "legendFormat": "{{gen_ai_request_model}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 8,
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Input tokens by model",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (gen_ai_request_model) (increase(gen_ai_client_inference_usage_input_tokens_total[90s]))",
     "legendFormat": "{{gen_ai_request_model}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 9,
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 8,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Model call time p95",
   "description": "The recorded latency of the replayed calls",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(gen_ai_client_inference_duration_seconds_bucket[90s])))",
     "legendFormat": "{{gen_ai_request_model}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 10,
   "gridPos": {
    "x": 8,
    "y": 13,
    "w": 8,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Writes by outcome",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (gen_ai_tool_name, larkfield_write_outcome) (increase(larkfield_writes_total[90s]))",
     "legendFormat": "{{gen_ai_tool_name}} {{larkfield_write_outcome}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 11,
   "gridPos": {
    "x": 16,
    "y": 13,
    "w": 8,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Approval wait p95",
   "description": "Practice time: the run records how long it waited for a person (an attribute, not a long span)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(larkfield_approval_wait_seconds_bucket[90s])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 12,
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 8,
