   }
  },
  {
   "type": "timeseries",
   "title": "Tool calls by status",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (gen_ai_tool_name, larkfield_tool_status) (increase(larkfield_tool_calls_total[90s]))",
     "legendFormat": "{{gen_ai_tool_name}} {{larkfield_tool_status}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
