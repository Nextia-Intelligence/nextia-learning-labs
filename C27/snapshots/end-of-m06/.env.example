# Copy this file to .env and change the password. Never commit .env.
# python -m idp init adds OIDC_CLIENT_SECRET and SESSION_SECRET to .env.

# The database (docker compose up -d db)
POSTGRES_PASSWORD=change-me-on-your-computer
DATABASE_URL=postgresql://assistant:change-me-on-your-computer@127.0.0.1:5432/assistant
TEST_DATABASE_URL=postgresql://assistant:change-me-on-your-computer@127.0.0.1:5432/assistant_test

# The course's "today", so that your answers match the lessons (empty = the real date)
ASSISTANT_TODAY=2026-10-11

# Answers: recorded (the course team's recorded answers; no key), mock (no model), or live
ANSWER_PROVIDER=recorded
ANSWER_MODEL=chat-small
# For ANSWER_PROVIDER=live: any OpenAI-compatible endpoint and your own key
LLM_BASE_URL=
LLM_API_KEY=
PROVIDER_TIMEOUT_S=20
PROVIDER_RETRIES=2

# Retrieval (Module 5): dense, hybrid, dense_rerank or hybrid_rerank; the answer prompt
RETRIEVAL_MODE=hybrid
PROMPT_VERSION=answer_v2
TORCH_THREADS=2

# Sign-in (Module 4): oidc with the practice identity provider (python -m idp)
AUTH_MODE=oidc
OIDC_ISSUER=http://localhost:8400
SESSION_COOKIE_SECURE=false
PUBLIC_URL=http://127.0.0.1:8000

# Usage limits per shop (Module 6); 0 = no limit
DAILY_QUESTION_LIMIT=200
MONTHLY_BUDGET_USD=5
