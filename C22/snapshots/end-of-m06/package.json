{
  "name": "ticket-desk",
  "version": "1.0.0",
  "private": true,
  "description": "Larkfield's help-desk interface: the running project of the frontend course of Nextia Learning.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "api": "node mock-api/server.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:profile": "tsc --noEmit && vite build --mode profile",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"mock-api/*.test.mjs\" \"scripts/*.test.mjs\" && vitest run",
    "test:e2e": "playwright test",
    "size": "node scripts/bundle-report.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm test && npm run build && npm run check:bundle && npm run size"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-virtual": "3.14.15",
    "dompurify": "3.4.16",
    "marked": "18.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
