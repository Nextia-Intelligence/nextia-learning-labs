# Copy this file to .env. Vite puts every VITE_ value into the JavaScript that the browser
# downloads, so a VITE_ value is public. Never put a key or a password here.
VITE_API_URL=http://127.0.0.1:8100

# A server secret (for example the AI provider's key) belongs to the server that calls the
# provider: here, the mock API. It has no VITE_ prefix, so Vite never puts it in the bundle,
# and `npm run check:bundle` fails if its value is found in dist/. The mock API does not use it.
# PROVIDER_API_KEY=
